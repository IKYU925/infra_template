# {{ ansible_managed }}
name: {{ app_name }}
services:
  app:
    image: {{ app_image }}
    restart: unless-stopped
    ports:
      - "{{ app_port }}:{{ app_container_port }}"
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
{% if app_env | length > 0 %}
    environment:
{% for key, value in app_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
