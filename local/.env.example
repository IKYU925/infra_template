# cp local/.env.example local/.env  (local/.env 는 git 에 올리지 않는다)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
APP_PORT=8080
APP_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine
AWS_REGION=ap-northeast-2
# localstack 프로필을 쓸 때만 필요할 수 있음
LOCALSTACK_AUTH_TOKEN=
